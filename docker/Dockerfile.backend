# MatrixFlow ERP - Backend Multi-Stage Build

# Stage 1: Build
FROM node:20-slim AS builder

WORKDIR /app

# Install build dependencies + OpenSSL for Prisma
RUN apt-get update && apt-get install -y python3 make g++ openssl && rm -rf /var/lib/apt/lists/*

# Copy workspace root config for the npm workspace context
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY backend/prisma ./backend/prisma/

# Install dependencies (--ignore-scripts avoids husky hooks)
ENV HUSKY=0 CI=true
RUN npm ci --ignore-scripts

# Copy source
COPY backend/ ./backend/

WORKDIR /app/backend

# Generate Prisma Client and build
RUN npm run db:generate
RUN npm run build:backend

# Stage 2: Production
FROM node:20-slim AS production

# Install runtime dependencies + OpenSSL (Prisma needs it)
RUN apt-get update && apt-get install -y curl tini openssl && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN addgroup -g 1001 -S matrixflow \
    && adduser -S matrixflow -u 1001 -G matrixflow

WORKDIR /app

# Copy built application
COPY --from=builder --chown=matrixflow:matrixflow /app/backend/dist ./dist
COPY --from=builder --chown=matrixflow:matrixflow /app/backend/package.json ./
COPY --from=builder --chown=matrixflow:matrixflow /app/backend/prisma ./prisma

# Install production dependencies with npm (flat node_modules, no broken symlinks)
RUN npm install --omit=dev --ignore-scripts

# Create logs and uploads directories
RUN mkdir -p /app/logs /app/uploads && chown -R matrixflow:matrixflow /app/logs /app/uploads

USER matrixflow

ENV NODE_ENV=production \
    PORT=3000 \
    HUSKY=0

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3000}/api/v1/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main.js"]
