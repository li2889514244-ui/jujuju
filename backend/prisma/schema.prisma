// MatrixFlow - Prisma Schema
// 数据库: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Enums ====================
enum UserRole {
  ADMIN
  MEMBER
  VIEWER
  OWNER
  MANAGER
  GROUP_LEADER
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum PostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
  SCHEDULED
  CANCELLED
}

enum PlatformEnum {
  DOUYIN
  KUAISHOU
  XIAOHONGSHU
  BILIBILI
  WEIBO
  WECHAT_VIDEO
  TIKTOK
  DOUDIAN
  XIAOHONGSHU_SHOP
  WECHAT_SHOP
}

enum AccountOperatorRole {
  PRIMARY
  COLLABORATOR
}

enum AccountCollectStatus {
  SUCCESS
  FAILED
  COLLECTING
}

// ==================== 用户与组织 ====================

enum EventType {
  RECORDING
  LIVESTREAM
  MEETING
  OTHER
}

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  phone           String?       @unique
  password        String?
  name            String
  avatar          String?
  authingUserId   String?       @unique
  feishuOpenId    String?       @unique
  feishuUnionId   String?       @unique
  feishuTenantKey String?
  role            UserRole      @default(MEMBER)
  status          AccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization                    Organization?              @relation(fields: [organizationId], references: [id])
  organizationId                  String?
  accounts                        Account[]
  accountOperators                AccountOperator[]
  performanceLadderConfigUpdates  PerformanceLadderConfig[]  @relation("PerformanceLadderConfigUpdatedBy")
  performanceLadderTeacherUpdates PerformanceLadderTeacher[] @relation("PerformanceLadderTeacherUpdatedBy")
  auditLogs                       AuditLog[]
  members                         TeamMember[]
  events                          CalendarEvent[]

  @@index([organizationId])
  @@index([email])
  @@index([feishuTenantKey])
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  plan        String        @default("FREE")
  status      AccountStatus @default(ACTIVE)
  maxAccounts Int           @default(20)
  maxUsers    Int           @default(10)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users                     User[]
  teams                     Team[]
  accounts                  Account[]
  posts                     Post[]
  postStats                 PostStats[]
  dailyStats                DailyStats[]
  competitors               Competitor[]
  competitorSnapshots       CompetitorSnapshot[]
  accountGroups             AccountGroup[]
  assets                    Asset[]
  notifications             Notification[]
  wechatStores              WechatStore[]
  wechatStoreOrders         WechatStoreOrder[]
  wechatStoreProducts       WechatStoreProduct[]
  wechatStoreAftersales     WechatStoreAftersale[]
  doudianStores             DoudianStore[]
  doudianStoreOrders        DoudianStoreOrder[]
  doudianStoreProducts      DoudianStoreProduct[]
  doudianStoreAftersales    DoudianStoreAftersale[]
  pixingVideoTasks          PixingVideoTask[]
  calendarEvents            CalendarEvent[]
  performanceLadderConfig          PerformanceLadderConfig?
  performanceLadderTeachers        PerformanceLadderTeacher[]
  performanceLadderMonthSnapshots  PerformanceLadderMonthSnapshot[]
  organizationSettings             OrganizationSetting[]

  @@index([status])
}

model OrganizationSetting {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  key            String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts    Account[]
  members     TeamMember[]
  permissions TeamPermission[]

  @@index([organizationId])
}

// ==================== 平台账号 ====================

model Account {
  id                      String                @id @default(cuid())
  platform                PlatformEnum
  platformUserId          String
  nickname                String
  avatar                  String?
  bio                     String?
  followers               Int                   @default(0)
  likes                   Int                   @default(0)
  following               Int                   @default(0)
  status                  AccountStatus         @default(ACTIVE)
  cookies                 String?
  cookieSavedAt           DateTime? // Cookie 上次保存时间，用于凭据健康监控
  proxyConfig             String? // JSON 字符串
  metadata                String? // JSON 字符串
  lastActiveAt            DateTime?
  lastSuccessfulCollectAt DateTime?
  lastCollectAttemptAt    DateTime?
  lastCollectStatus       AccountCollectStatus?
  lastCollectError        String?
  storeScore              Float?
  storeDiagnosis          String?
  organization            Organization?         @relation(fields: [organizationId], references: [id])
  organizationId          String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  owner      User              @relation(fields: [userId], references: [id])
  userId     String
  team       Team?             @relation(fields: [teamId], references: [id])
  teamId     String?
  group      AccountGroup?     @relation(fields: [groupId], references: [id])
  groupId    String?
  posts      Post[]
  dailyStats DailyStats[]
  operators  AccountOperator[]

  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([teamId])
  @@index([groupId])
  @@index([platform])
  @@index([organizationId])
  @@index([lastCollectStatus])
  @@index([lastSuccessfulCollectAt])
}

model PerformanceLadderConfig {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String       @unique
  monthlyTarget    Int          @default(0)
  refundMode       String       @default("include")
  sourceIgnoreMode String       @default("exclude")
  hideUnmatched    Boolean      @default(true)
  sourceOperators  String       @default("{}") // JSON: source account key -> operator name
  sourceIgnoreList String       @default("[]") // JSON array
  updatedByUser    User?        @relation("PerformanceLadderConfigUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([updatedByUserId])
}

model PerformanceLadderTeacher {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  name            String
  aliases         String       @default("[]") // JSON array
  monthlyTarget   Int          @default(0)
  enabled         Boolean      @default(true)
  sortOrder       Int          @default(0)
  updatedByUser   User?        @relation("PerformanceLadderTeacherUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, enabled, sortOrder])
  @@index([updatedByUserId])
}

// 业绩天梯月度快照：冻结每个自然月当时生效的目标/归因规则。
// 老师目标与归因规则主表只保存当前值；查看历史月份时读取该月快照，
// 避免后续修改当前配置导致历史月份成绩被重新计算。
model PerformanceLadderMonthSnapshot {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  yearMonth       String // "YYYY-MM"
  targets         String       @default("[]") // JSON: [{ id, name, aliases, monthlyTarget }]
  sourceOperators String       @default("{}") // JSON: source account key -> operator name
  hideUnmatched   Boolean      @default(true)
  capturedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
  @@index([yearMonth])
}

// ==================== 内容发布 ====================

model AccountOperator {
  id        String              @id @default(cuid())
  accountId String
  userId    String
  role      AccountOperatorRole @default(COLLABORATOR)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([accountId, role])
}

model Post {
  id             String        @id @default(cuid())
  title          String?
  content        String?
  mediaUrls      String? // JSON 字符串
  coverUrl       String? // 封面图URL
  tags           String? // JSON 字符串，逗号分隔
  publishAt      DateTime?
  status         PostStatus    @default(DRAFT)
  platformUrl    String?
  errorMsg       String?
  metadata       String? // JSON 字符串
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account   Account    @relation(fields: [accountId], references: [id])
  accountId String
  stats     PostStats?

  @@index([accountId])
  @@index([status])
  @@index([publishAt])
  @@index([accountId, status])
  @@index([organizationId])
}

// ==================== 互动统计 ====================

model PostStats {
  id                    String   @id @default(cuid())
  views                 Int      @default(0)
  likes                 Int      @default(0)
  comments              Int      @default(0)
  shares                Int      @default(0)
  saves                 Int      @default(0)
  completionRate        Float    @default(0) // 完播率(%)
  fiveSecCompletionRate Float    @default(0) // 5秒完播率(%)
  coverClickRate        Float    @default(0) // 封面点击率(%)
  avgPlayDuration       Float    @default(0) // 平均播放时长(秒)
  videoDuration         Int      @default(0) // 视频时长(秒)
  danmakuCount          Int      @default(0) // 弹幕数
  dislikes              Int      @default(0) // 不喜欢数
  followsFromPost       Int      @default(0) // 涨粉数
  collectedAt           DateTime @default(now())

  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String        @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([postId])
  @@index([organizationId])
}

model DailyStats {
  id                 String        @id @default(cuid())
  date               DateTime
  platform           PlatformEnum
  followers          Int           @default(0)
  views              Int           @default(0)
  likes              Int           @default(0)
  comments           Int           @default(0)
  shares             Int           @default(0)
  revenue            Int           @default(0)
  gmv                Int           @default(0)
  orders             Int           @default(0)
  commission         Int           @default(0)
  buyerCount         Int           @default(0)
  productCount       Int           @default(0)
  avgOrderValue      Int           @default(0)
  // 增量字段（当日较前日变化）
  followersIncrement Int           @default(0)
  viewsIncrement     Int           @default(0)
  likesIncrement     Int           @default(0)
  commentsIncrement  Int           @default(0)
  sharesIncrement    Int           @default(0)
  unfollows          Int           @default(0)
  organization       Organization? @relation(fields: [organizationId], references: [id])
  organizationId     String?
  createdAt          DateTime      @default(now())

  account   Account @relation(fields: [accountId], references: [id])
  accountId String

  @@unique([accountId, date])
  @@index([accountId])
  @@index([date])
  @@index([accountId, date])
  @@index([organizationId])
}

// ==================== 审计日志 ====================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String
  detail    String? // JSON 字符串
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([userId, createdAt])
}

// ==================== 竞品监控 ====================

model Competitor {
  id             String        @id @default(cuid())
  platform       PlatformEnum
  platformUserId String
  nickname       String
  avatar         String?
  bio            String?
  followers      Int           @default(0)
  following      Int           @default(0)
  status         AccountStatus @default(ACTIVE)
  note           String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId    String
  snapshots CompetitorSnapshot[]

  @@unique([platform, platformUserId, userId])
  @@index([userId])
  @@index([platform])
  @@index([organizationId])
}

model CompetitorSnapshot {
  id        String   @id @default(cuid())
  date      DateTime
  followers Int      @default(0)
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  posts     Int      @default(0)
  createdAt DateTime @default(now())

  competitor     Competitor    @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorId   String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@unique([competitorId, date])
  @@index([competitorId])
  @@index([date])
  @@index([organizationId])
}

// ==================== 账号分组 ====================

model AccountGroup {
  id             String        @id @default(cuid())
  name           String
  color          String        @default("#409EFF")
  sortOrder      Int           @default(0)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId   String
  accounts Account[]

  @@index([userId])
  @@index([organizationId])
}

// ==================== 素材库 ====================

model Asset {
  id             String        @id @default(cuid())
  name           String
  type           String
  url            String
  size           Int           @default(0)
  width          Int?
  height         Int?
  duration       Int?
  mimeType       String?
  tags           String? // JSON 字符串，逗号分隔
  folderId       String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId String

  @@index([userId])
  @@index([type])
  @@index([folderId])
  @@index([organizationId])
}

// ==================== 通知 ====================

model Notification {
  id             String        @id @default(cuid())
  type           String
  title          String
  content        String?
  read           Boolean       @default(false)
  metadata       String? // JSON 字符串
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())

  userId String

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read, createdAt])
  @@index([organizationId])
}

model TeamMember {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     UserRole @default(MEMBER)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

// ==================== 权限管理 ====================

model TeamPermission {
  id           String   @id @default(cuid())
  teamId       String
  roleType     String // "admin" or "member"
  permissionId String // e.g. "manage_accounts", "view_content"
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, roleType, permissionId])
  @@index([teamId])
}

model WechatStore {
  id             String        @id @default(cuid())
  name           String
  appId          String        @unique
  appSecret      String
  status         AccountStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  syncStatus     String        @default("pending")
  syncError      String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders     WechatStoreOrder[]
  products   WechatStoreProduct[]
  aftersales WechatStoreAftersale[]

  @@index([organizationId])
}

model WechatStoreOrder {
  id             String   @id @default(cuid())
  storeId        String
  organizationId String?
  orderId        String
  productId      String?
  skuId          String?
  status         Int      @default(0)
  payAmount      Int      @default(0)
  createTime     Int      @default(0)
  settleTime     Int      @default(0)
  productTitle   String   @default("")
  productImg     String   @default("")
  shipTime       Int      @default(0)
  deliveryList   Json?
  raw            Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        WechatStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, orderId])
  @@index([storeId, createTime])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId, createTime])
  @@index([syncedAt])
}

model WechatStoreProduct {
  id             String   @id @default(cuid())
  storeId        String
  organizationId String?
  productId      String
  title          String   @default("")
  imgUrl         String   @default("")
  sellingPrice   Int      @default(0)
  sales          Int      @default(0)
  stock          Int      @default(0)
  status         Int      @default(0)
  raw            Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        WechatStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, productId])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId])
  @@index([syncedAt])
}

model WechatStoreAftersale {
  id               String   @id @default(cuid())
  storeId          String
  organizationId   String?
  afterSaleOrderId String
  type             String   @default("")
  status           String   @default("")
  amount           Int      @default(0)
  reason           String   @default("")
  product          String   @default("")
  productId        String?
  completeTime     Int      @default(0)
  createTime       Int      @default(0)
  raw              Json
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store        WechatStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, afterSaleOrderId])
  @@index([storeId, createTime])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId, createTime])
  @@index([syncedAt])
}

model DoudianStore {
  id             String        @id @default(cuid())
  name           String
  profilePath    String        @unique
  status         AccountStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  syncStatus     String        @default("pending")
  syncError      String?
  sessionStatus  String        @default("unknown")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders     DoudianStoreOrder[]
  products   DoudianStoreProduct[]
  aftersales DoudianStoreAftersale[]

  @@index([organizationId])
}

model DoudianStoreOrder {
  id             String   @id @default(cuid())
  storeId        String
  organizationId String?
  orderId        String
  status         Int      @default(0)
  payAmount      Int      @default(0)
  postAmount     Int      @default(0)
  productCount   Int      @default(0)
  createTime     Int      @default(0)
  updateTime     Int      @default(0)
  productTitle   String   @default("")
  productImg     String   @default("")
  raw            Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        DoudianStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, orderId])
  @@index([storeId, createTime])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId, createTime])
  @@index([syncedAt])
}

model DoudianStoreProduct {
  id             String   @id @default(cuid())
  storeId        String
  organizationId String?
  productId      String
  title          String   @default("")
  imgUrl         String   @default("")
  minPrice       Int      @default(0)
  maxPrice       Int      @default(0)
  sales          Int      @default(0)
  stock          Int      @default(0)
  status         Int      @default(0)
  raw            Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        DoudianStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, productId])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId])
  @@index([syncedAt])
}

model DoudianStoreAftersale {
  id             String   @id @default(cuid())
  storeId        String
  organizationId String?
  afterSaleId    String
  orderId        String   @default("")
  type           Int      @default(0)
  status         Int      @default(0)
  amount         Int      @default(0)
  product        String   @default("")
  productId      String?
  createTime     Int      @default(0)
  updateTime     Int      @default(0)
  raw            Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        DoudianStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storeId, afterSaleId])
  @@index([storeId, createTime])
  @@index([storeId, status])
  @@index([organizationId])
  @@index([organizationId, storeId, createTime])
  @@index([syncedAt])
}

model PixingVideoTask {
  id             String        @id @default(cuid())
  userId         String
  teacher        String
  text           String
  status         String        @default("pending")
  videoUrl       String?
  srtContent     String?
  error          String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// ==================== MCP Key 管理 ====================

model McpKey {
  id        String   @id @default(cuid())
  clientId  String   @unique
  token     String   @unique
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([token])
}

model CalendarEvent {
  id             String        @id @default(cuid())
  title          String
  description    String?
  eventType      EventType     @default(OTHER)
  startTime      DateTime
  endTime        DateTime
  color          String        @default("#409EFF")
  allDay         Boolean       @default(false)
  location       String?
  userId         String
  teamId         String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([startTime])
  @@index([organizationId])
}

// ==================== 伴侣监控中心 ====================

model CompanionDevice {
  id                         String               @id @default(cuid())
  deviceId                   String               @unique
  deviceName                 String               @default("")
  ownerUserId                String?
  ownerName                  String?
  organizationId             String?
  companionVersion           String               @default("")
  startedAt                  DateTime?
  firstSeenAt                DateTime             @default(now())
  lastSeenAt                 DateTime?
  lastHeartbeatAt            DateTime?
  healthStatus               String               @default("unknown") // online / unstable / offline / unknown
  currentTask                String? // idle/collecting/syncing/uploading/queued/updating/error
  currentTaskDetail          Json?
  taskStartedAt              DateTime?
  platformSummary            Json?
  lastCollectionAt           DateTime?
  lastCollectionSuccess      Boolean?
  lastCollectionAccountCount Int?
  lastSyncAt                 DateTime?
  lastSyncSuccess            Boolean?
  lastSyncUploadCount        Int?
  lastSyncErrorCode          String?
  lastErrorCode              String?
  lastErrorMessage           String?
  lastErrorAt                DateTime?
  updateStatus               Json?
  cpuPercent                 Float?
  memoryMb                   Float?
  processUptimeSeconds       Int?
  consecutiveSyncFailures    Int                  @default(0)
  recentHttpErrors           Json?
  // Phase 2: 运行周期 / 崩溃检测 / UI 模式 / 进度时间戳
  bootId                     String?
  bootSeq                    Int                  @default(0)
  bootCount                  Int                  @default(0)
  exitState                  String? // clean 表示上次运行正常退出（优雅退出信标）
  uiMode                     String               @default("") // webview / browser / unknown
  startupDiagnostic          Json?
  lastProgressAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  CompanionHeartbeat         CompanionHeartbeat[]

  @@index([organizationId])
  @@index([healthStatus])
  @@index([lastHeartbeatAt])
  @@index([bootId])
}

model CompanionHeartbeat {
  id                   String   @id @default(cuid())
  deviceId             String
  receivedAt           DateTime @default(now())
  companionVersion     String   @default("")
  taskStatus           String?
  taskDetail           Json?
  platformSummary      Json?
  lastCollection       Json?
  lastSync             Json?
  lastError            Json?
  update               Json?
  cpuPercent           Float?
  memoryMb             Float?
  processUptimeSeconds Int?
  ownerName            String?
  bootId               String?
  seq                  Int?

  device CompanionDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId, receivedAt])
  @@index([receivedAt])
}

model CompanionAlert {
  id             String   @id @default(cuid())
  deviceId       String?
  type           String // SYNC_FAIL_3X / OFFLINE_24H / HEARTBEAT_STALE / TASK_TIMEOUT / UPDATE_FAILED / VERSION_OUTDATED / HTTP_ERROR_SPIKE / LOGIN_EXPIRED_MASS
  message        String
  status         String   @default("open") // open / acknowledged
  organizationId String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// Phase 2: 事件原始记录 + 故障聚合（Incident 生命周期 open -> recovering -> resolved）
model CompanionEvent {
  id             String   @id @default(cuid())
  deviceId       String?
  type           String // BOOT_STARTED / CRASH_SUSPECTED / TASK_STUCK / 各告警类型
  message        String
  organizationId String?
  createdAt      DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([type, createdAt])
  @@index([organizationId])
}

model CompanionIncident {
  id              String    @id @default(cuid())
  deviceId        String? // 组织级故障为 null（如大量登录态失效）
  type            String
  message         String
  status          String    @default("open") // open / recovering / resolved
  occurrences     Int       @default(1)
  firstOccurredAt DateTime  @default(now())
  lastOccurredAt  DateTime  @default(now())
  recoveringSince DateTime?
  recoveredAt     DateTime?
  resolvedAt      DateTime?
  durationSeconds Int?
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deviceId, type, status])
  @@index([status])
  @@index([organizationId])
}

// ==================== 统一系统健康中心 ====================

model SystemEvent {
  id               String   @id @default(cuid())
  sourceType       String
  sourceId         String?
  organizationId   String?
  userId           String?
  deviceId         String?
  bootId           String?
  requestId        String?
  taskId           String?
  accountId        String?
  storeId          String?
  platform         String?
  frontendVersion  String?
  backendVersion   String?
  companionVersion String?
  eventType        String
  severity         String   @default("INFO")
  errorCode        String?
  message          String
  occurredAt       DateTime @default(now())
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([sourceType, occurredAt])
  @@index([eventType, occurredAt])
  @@index([severity, occurredAt])
  @@index([errorCode, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([requestId])
  @@index([deviceId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([storeId, occurredAt])
}

model SystemIncident {
  id                String    @id @default(cuid())
  sourceType        String
  scope             String    @default("global")
  organizationId    String?
  errorCode         String?
  severity          String    @default("ERROR")
  status            String    @default("OPEN")
  firstOccurredAt   DateTime  @default(now())
  lastOccurredAt    DateTime  @default(now())
  recoveryStartedAt DateTime?
  resolvedAt        DateTime?
  occurrenceCount   Int       @default(1)
  affectedUsers     Int       @default(0)
  affectedDevices   Int       @default(0)
  affectedAccounts  Int       @default(0)
  affectedStores    Int       @default(0)
  affectedVersions  Json?
  title             String
  summary           String
  rootCause         String?
  resolution        String?
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  dedupeKey         String
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([sourceType, status])
  @@index([status, severity])
  @@index([dedupeKey, status])
  @@index([organizationId, status])
  @@index([lastOccurredAt])
}
